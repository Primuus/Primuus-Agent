+def test_natural_list(test_args: list[Any], expected: str) -> None:
     assert humanize.natural_list(*test_args) == expected
+
+
+def test_natural_list_generator() -> None:
+    assert (
+        humanize.natural_list(item for item in ["one", "two", "three"])
+        == "one, two and three"
+    )
+
+
+class _CountedStr:
+    def __init__(self, value: str) -> None:
+        self.value = value
+        self.calls = 0
+
+    def __str__(self) -> str:
+        self.calls += 1
+        return self.value
+
+
+def test_natural_list_stringifies_each_item_once() -> None:
+    items = [_CountedStr("one"), _CountedStr("two"), _CountedStr("three")]
+    assert humanize.natural_list(items) == "one, two and three"
+    assert [item.calls for item in items] == [1, 1, 1]
