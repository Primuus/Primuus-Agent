      "id": "intword_rounding_carry",
      "base_commit": "f971127ce7e7770d3ff5be05cfc484bdf9302e04",
      "next_commit": "ca892b368a535a79cc5e2181d052245b94fd6652",
      "instruction": "humanize.intword can display a value just below the next named power as 1000.0 of the lower unit. When formatting rounds to the next named unit, carry the result to that unit. Preserve the documented gap between decillion and googol.",
      "check": "PYTHONPATH=src python -m pytest -q tests/test_number.py",
      "verifier_code": "import humanize\nfor power, unit in [(24, 'septillion'), (27, 'octillion'), (30, 'nonillion'), (33, 'decillion')]:\n    assert humanize.intword(10**power - 1) == f'1.0 {unit}'\n    assert humanize.intword(10**power - 1, '%.0f') == f'1 {unit}'\nassert humanize.intword(10**36) == '1000.0 decillion'\nassert humanize.intword(2 * 10**100) == '2.0 googol'"
    }
  ],
