diff --git a/src/humanize/number.py b/src/humanize/number.py
index ebccfb9..1da0e7b 100644
--- a/src/humanize/number.py
+++ b/src/humanize/number.py
@@ -282,7 +282,14 @@ def intword(value: NumberOrString, format: str = "%.1f") -> str:
     chopped = value / power
     rounded_value = float(format % chopped)
 
-    if not largest_ordinal and rounded_value * power == powers[ordinal + 1]:
+    # Compare against the exact ratio between the two powers rather than the
+    # product ``rounded_value * power``.  The product goes through a float and
+    # loses precision at large magnitudes (e.g. just below a googol), which
+    # used to leave values displayed as ``1000.0`` of the lower unit instead of
+    # carrying into the next named unit.  The ratio keeps the documented gap
+    # between decillion and googol intact: a value only carries when it really
+    # rounds up to the next power.
+    if not largest_ordinal and rounded_value == powers[ordinal + 1] / power:
         # After rounding, we end up just at the next power
         ordinal += 1
         rounded_value = 1.0
