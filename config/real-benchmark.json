{
  "max_steps": 80,
  "repository_max_steps": 80,
  "max_tokens": 120000,
  "context_max_chars": 60000,
  "context_keep_messages": 12,
  "project_instruction_files": [
    "AGENTS.md"
  ],
  "skills": [],
  "hooks": {
    "before_tool": [],
    "after_tool": []
  },
