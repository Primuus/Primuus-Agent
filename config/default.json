{
  "max_steps": 20,
  "repository_max_steps": 80,
  "max_tokens": null,
  "action_review_after_tokens": 40000,
  "context_max_chars": 24000,
  "context_keep_messages": 8,
  "context_tool_output_chars": 4000,
  "project_instruction_files": ["AGENTS.md"],
  "skills": [],
  "hooks": {"before_tool": [], "after_tool": []},
  "mcp_servers": [],
  "memory": {"mode": "off", "max_entries": 3, "max_chars": 2500},
  "recovery": {
    "enabled": true,
    "model_retries": 2,
    "tool_retries": 1,
    "validation_retries": 1,
    "repeat_blocks": 2
  },
  "task_timeout_seconds": 600,
  "tool_timeout_seconds": 30,
  "verifier_timeout_seconds": 60,
  "model": {
    "backend": "openai_compatible",
    "name": "deepseek-flash",
    "base_url": "https://api.deepseek.com",
    "max_output_tokens": 8192,
    "reasoning_effort": "low",
    "final_reasoning_effort": "none"
  },
  "sandbox": {
    "image": "coding-agent-sandbox:local",
    "workspace": "/workspace",
    "cpus": 1.0,
    "memory_mb": 512,
    "network_enabled": false
  },
  "results_dir": "runs"
}
