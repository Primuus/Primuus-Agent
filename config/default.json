{
  "max_steps": 20,
  "repository_max_steps": 80,
  "max_tokens": 120000,
  "context_max_chars": 60000,
  "context_keep_messages": 12,
  "project_instruction_files": ["AGENTS.md"],
  "skills": [],
  "hooks": {"before_tool": [], "after_tool": []},
  "recovery": {
    "enabled": true,
    "model_retries": 2,
    "tool_retries": 1,
    "validation_retries": 1,
    "repeat_blocks": 2
  },
  "task_timeout_seconds": 600,
  "tool_timeout_seconds": 30,
  "verifier_timeout_seconds": 60,
  "model": {
    "backend": "openai_compatible",
    "name": "deepseek-flash",
    "base_url": "https://api.deepseek.com"
  },
  "sandbox": {
    "image": "coding-agent-sandbox:local",
    "workspace": "/workspace",
    "cpus": 1.0,
    "memory_mb": 512,
    "network_enabled": false
  },
  "results_dir": "runs"
}
